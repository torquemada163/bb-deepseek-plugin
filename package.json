{
  "name": "bb-plugin-deepseek",
  "version": "0.1.1",
  "type": "module",
  "engines": {
    "node": ">=22",
    "bb": ">=0.48.1",
    "bbPluginSdk": ">=0.6.104 <0.7"
  },
  "bb": {
    "name": "DeepSeek",
    "description": "Use DeepSeek models as a dedicated coding agent in BB, with file tools, terminal commands, and host-local API credentials.",
    "branding": {
      "icon": "./assets/deepseek.svg"
    },
    "server": "./server.ts",
    "host": "./host.ts",
    "skills": [
      "skills"
    ]
  },
  "dependencies": {
    "@get-bb/plugin-sdk": "0.6.104",
    "dotenv": "^17.2.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "bb-app": "0.48.1",
    "better-sqlite3": "^13.0.3",
    "cron-parser": "^5.5.0",
    "hono": "^4.11.9",
    "tsx": "^4.20.0",
    "typescript": "^5.7.0",
    "opencode-ai": "1.19.5"
  },
  "description": "Independent DeepSeek coding agent provider for BB, powered by OpenCode ACP.",
  "license": "MIT",
  "files": [
    "server.ts",
    "host.ts",
    "src",
    "skills",
    "dist",
    "assets",
    "README.md",
    "LICENSE",
    "PLUGIN_OVERVIEW.md",
    "CHANGELOG.md",
    "docs",
    ".env.example"
  ],
  "scripts": {
    "build": "bb plugin build",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts && tsx test/conformance.ts",
    "smoke": "tsx scripts/smoke.ts",
    "check:install": "node scripts/check-git-install.mjs",
    "check:package": "node scripts/check-package.mjs",
    "smoke:matrix": "tsx scripts/smoke-matrix.ts"
  },
  "keywords": [
    "bb",
    "bb-plugin",
    "deepseek",
    "opencode",
    "acp",
    "coding-agent"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/torquemada163/bb-deepseek-plugin.git"
  },
  "homepage": "https://github.com/torquemada163/bb-deepseek-plugin#readme",
  "bugs": {
    "url": "https://github.com/torquemada163/bb-deepseek-plugin/issues"
  }
}
